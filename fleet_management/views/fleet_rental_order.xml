<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_fleet_vehicle_rental_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.rental.form</field>
        <field name="model">fleet.vehicle.rental</field>
        <field name="arch" type="xml">
            <form string="Vehicle Rental">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                    </group>
                    <group>
                        <group>
                           <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/> 
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Enter additional rental notes here..." nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fleet_vehicle_rental_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.rental.list</field>
        <field name="model">fleet.vehicle.rental</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="fleet_vehicle_rental_action" model="ir.actions.act_window">
        <field name="name">Rental Orders</field>
        <field name="res_model">fleet.vehicle.rental</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first vehicle rental order
            </p>
        </field>
    </record>
</odoo>